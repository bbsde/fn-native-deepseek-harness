#!/bin/bash
# Upgrades carry a fresh runtime.tar.gz; re-extract over the old tree.
set -e

RUNTIME_TAR="${TRIM_APPDEST}/runtime.tar.gz"
RUNTIME_DIR="${TRIM_PKGVAR}/runtime"

if [ ! -f "$RUNTIME_TAR" ]; then
  echo "runtime tar missing: $RUNTIME_TAR" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
  exit 1
fi

rm -rf "$RUNTIME_DIR"
mkdir -p "$RUNTIME_DIR"
tar xzf "$RUNTIME_TAR" -C "$RUNTIME_DIR"

# The appcenter upgrade chown-walks TRIM_PKGVAR after the callbacks return;
# a single dangling symlink (pnpm .bin shims whose packages were removed)
# fails that walk with ENOENT and aborts the whole upgrade — observed as the
# app tree wiped and an APP_CRASH loop. Sweep them before handing back.
find "$TRIM_PKGVAR" -xtype l -delete 2>/dev/null || true

exit 0
