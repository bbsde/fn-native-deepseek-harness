#!/bin/bash
# Extracts the single-file dsh runtime (33k files as one tarball) into
# TRIM_PKGVAR/runtime. Shipping the tree as individual files made fnOS
# installation take minutes (per-file verify + ACL); one tarball installs in
# seconds and extracts here in well under a minute.
set -e

RUNTIME_TAR="${TRIM_APPDEST}/runtime.tar.gz"
RUNTIME_DIR="${TRIM_PKGVAR}/runtime"

if [ ! -f "$RUNTIME_TAR" ]; then
  echo "runtime tar missing: $RUNTIME_TAR" > "${TRIM_TEMP_LOGFILE:-/dev/null}"
  exit 1
fi

rm -rf "$RUNTIME_DIR"
mkdir -p "$RUNTIME_DIR"
tar xzf "$RUNTIME_TAR" -C "$RUNTIME_DIR"

# Same guard as upgrade_callback: dangling symlinks anywhere under the data
# dir abort the appcenter chown walk during upgrades.
find "$TRIM_PKGVAR" -xtype l -delete 2>/dev/null || true

# System-level home for the dsh account: /home/dsh -> TRIM_PKGHOME. The
# passwd entry for app accounts points at /home/<name> but nothing creates
# it (fnOS's own apps maintain theirs the same way — see hermes); without it
# every process that resolves the account home lands on a missing path.
# Idempotent; never clobbers a real directory at /home/<name>.
if [ -n "${TRIM_PKGHOME:-}" ] && [ -d "${TRIM_PKGHOME}" ]; then
  ln -sfn "${TRIM_PKGHOME}" "/home/${TRIM_APPNAME:-dsh}" 2>/dev/null || true
fi

exit 0
